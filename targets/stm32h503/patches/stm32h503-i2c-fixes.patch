+        let offset = addr - 0x0800_0000;
+        let bank2 = offset >= 0x1_0000;
+        let sector = (((offset % 0x1_0000) / 8192) as u8) & 0x07;
         Self::wait_ready();
         stm32_metapac::FLASH.nsccr().write(|w| {
             w.set_clr_eop(true);
@@ -50,6 +54,7 @@ impl FlashTarget for H503Flash {
