             w.set_ser(true);
             w.set_snb(sector);
+            w.set_bksel(if bank2 { stm32_metapac::flash::vals::Bksel::BANK2 } else { stm32_metapac::flash::vals::Bksel::BANK1 });
         });
         stm32_metapac::FLASH.nscr().modify(|w| {
             w.set_strt(true);
