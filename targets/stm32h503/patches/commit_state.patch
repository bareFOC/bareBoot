diff --git a/src/generic/armcm_canboot.c b/src/generic/armcm_canboot.c
index 5398bf1..a295bea 100644
--- a/src/generic/armcm_canboot.c
+++ b/src/generic/armcm_canboot.c
@@ -11,6 +11,7 @@
 #include "board/irq.h" // irq_disable
 #include "canboot.h" // get_bootup_code
 #include "command.h" // DECL_CONSTANT_STR
+#include "commit_state.h" // commit_state_valid
 
 // Export MCU type
 DECL_CONSTANT_STR("MCU", CONFIG_MCU);
@@ -78,10 +79,29 @@ application_check_valid(void)
         return 0;
 #if defined(CONFIG_FLASH_SIZE)
     // 2. PC must lie within flash application region
-    if (pc < CONFIG_LAUNCH_APP_ADDRESS || pc >= (CONFIG_FLASH_START + CONFIG_FLASH_SIZE))
+    if (pc < CONFIG_LAUNCH_APP_ADDRESS || pc >= (CONFIG_FLASH_START + CONFIG_FLASH_SIZE - 4))
         return 0;
 #endif
 
+    // Multi-Vector Verification: HardFault_Handler (app[3])
+    uint32_t hardfault = app[3];
+    if (hardfault == 0xffffffff || hardfault == 0 || (hardfault & 1) == 0)
+        return 0;
+#if defined(CONFIG_FLASH_SIZE)
+    if (hardfault < CONFIG_LAUNCH_APP_ADDRESS || hardfault >= (CONFIG_FLASH_START + CONFIG_FLASH_SIZE))
+        return 0;
+#endif
+
+    // Entry Opcode Sanity: Dereference first instruction opcode at pc & ~1
+    const volatile uint32_t *entry_code = (const volatile uint32_t *)(pc & ~1);
+    if (*entry_code == 0xffffffff || *entry_code == 0)
+        return 0;
+
+    // BareBoot: a committed (fully verified) update is required. A torn or
+    // interrupted transfer leaves UPDATE_IN_PROGRESS, which must never boot.
+    if (!commit_state_valid())
+        return 0;
+
     return 1;
 }
 
