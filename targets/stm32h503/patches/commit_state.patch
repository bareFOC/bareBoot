diff --git a/src/Makefile b/src/Makefile
index 3df8c24..b4d53a7 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -1,6 +1,8 @@
 # Main code build rules
 
 src-y += sched.c bootentry.c command.c flashcmd.c initial_pins.c
+src-$(CONFIG_MACH_RP2350) += commit_state.c
